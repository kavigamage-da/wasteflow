# WasteFlow backend environment configuration
# Copy to .env and fill in. Never commit .env.

# --- Database ---
DATABASE_URL=postgres://wasteflow:wasteflow@localhost:5432/wasteflow
# Used by migrate/seed if DATABASE_URL is not set:
PGHOST=localhost
PGPORT=5432
PGUSER=wasteflow
PGPASSWORD=wasteflow
PGDATABASE=wasteflow

# --- Auth ---
# IMPORTANT: Generate strong secrets for production deployment
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Minimum 32 bytes (64 hex characters) recommended for HS256
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# --- Server ---
PORT=3000
NODE_ENV=development
# For development: http://localhost:5173
# For production: comma-separated list of allowed origins, e.g., https://dashboard.wasteflow.gov
CORS_ORIGIN=http://localhost:5173

# --- Behaviour flags (administrative, not hard-coded) ---
# Reference capacity (MT/day) — a configurable administrative value, not a live limit.
REFERENCE_CAPACITY_MT_DAY=40
# GPS capture is optional; the system must function without it.
ENABLE_GPS=false

# Path to the SQL schema/seed used by `npm run migrate` / `npm run seed`
SCHEMA_PATH=../database/schema.sql
SEED_PATH=../database/seed.sql
